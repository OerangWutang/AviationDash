# Copy to your deployment environment and replace every placeholder.
# Generate database and metrics secrets with at least 16 URI-unreserved
# characters (for example, `openssl rand -hex 32`). Compose uses each database
# password both literally and inside its connection URL.
ATLAS_ARGUS_ENV=production
ATLAS_ARGUS_MIGRATION_DB_PASSWORD=replace-with-generated-migration-owner-password
ATLAS_ARGUS_RUNTIME_DB_PASSWORD=replace-with-generated-runtime-role-password
ATLAS_ARGUS_DATABASE_URL=postgresql+psycopg://atlas_app:replace-with-generated-runtime-role-password@db:5432/atlas_argus
ATLAS_ARGUS_MIGRATION_DATABASE_URL=postgresql+psycopg://atlas_owner:replace-with-generated-migration-owner-password@db:5432/atlas_argus
ATLAS_ARGUS_METRICS_TOKEN=replace-with-generated-metrics-token
ATLAS_ARGUS_MAX_REQUEST_BODY_BYTES=262144
ATLAS_ARGUS_MAX_PACKET_ENTRIES=250
ATLAS_ARGUS_MAX_PACKET_DOCUMENT_BYTES=2097152
ATLAS_ARGUS_MAX_PACKET_MANIFEST_BYTES=524288
ATLAS_ARGUS_MAX_PACKET_ARTIFACT_BYTES=3145728
ATLAS_ARGUS_MAX_CASE_STATE_ROWS=10000
ATLAS_ARGUS_MAX_PACKET_HISTORY_ROWS=1000
ATLAS_ARGUS_REQUEST_BODY_TIMEOUT_SECONDS=120
# Must match the API service mem_limit. Startup verifies the aggregate
# ingestion/render envelope fits this container budget.
ATLAS_ARGUS_API_MEMORY_LIMIT_BYTES=1610612736
# Absolute host paths mounted read-only into the API container. Generate the
# key with `openssl rand -hex 32`, chmod it 600, and retain checkpoint copies
# in externally controlled immutable storage.
ATLAS_ARGUS_INTEGRITY_ANCHOR_DIR=/srv/atlas-argus/integrity-anchors
ATLAS_ARGUS_INTEGRITY_ANCHOR_KEY_FILE=/srv/atlas-argus/secrets/integrity-anchor.key
# Document ingestion. All optional — these are the defaults the API applies if
# unset. Uploading requires poppler-utils and tesseract-ocr in the image.
# The API refuses to start if SOURCE_CHILD_MEMORY_LIMIT_BYTES is below 3x
# MAX_SOURCE_UPLOAD_BYTES: extraction must hold the decoded document, a
# rendered page raster, and OCR working memory at once.
# MAX_CONCURRENT_SOURCE_INGESTIONS is PER API PROCESS, and production runs
# exactly one worker — raising the worker count multiplies both this limit and
# the memory ceiling. See docs/production-readiness.md.
ATLAS_ARGUS_MAX_SOURCE_UPLOAD_BYTES=26214400
ATLAS_ARGUS_MAX_SOURCE_PAGE_COUNT=200
ATLAS_ARGUS_SOURCE_OCR_PAGE_TIMEOUT_SECONDS=20
ATLAS_ARGUS_SOURCE_INGESTION_TIMEOUT_SECONDS=300
ATLAS_ARGUS_MAX_EXTRACTED_TEXT_BYTES_PER_PAGE=51200
ATLAS_ARGUS_MAX_TOTAL_EXTRACTED_TEXT_BYTES=25165824
ATLAS_ARGUS_MAX_CONCURRENT_SOURCE_INGESTIONS=2
ATLAS_ARGUS_SOURCE_CHILD_MEMORY_LIMIT_BYTES=536870912
ATLAS_ARGUS_MIN_OCR_CONFIDENCE_FOR_AUTO_VERIFY=70
# Controlled PDF export. Production refuses to boot without WeasyPrint, its
# system libraries (Pango/HarfBuzz/fontconfig) and document fonts installed.
ATLAS_ARGUS_MAX_PACKET_PDF_BYTES=20971520
ATLAS_ARGUS_MAX_CONCURRENT_PACKET_RENDERS=1
ATLAS_ARGUS_CORS_ORIGINS=
ATLAS_ARGUS_FORWARDED_ALLOW_IPS=replace-with-reverse-proxy-ip-or-cidr
ATLAS_ARGUS_BACKUP_DIR=backups
ATLAS_ARGUS_BACKUP_RETENTION_DAYS=30
ATLAS_ARGUS_BACKUP_DB_USER=atlas_owner
ATLAS_ARGUS_BACKUP_OFFSITE_URI=replace-with-rclone-remote:path
ATLAS_ARGUS_BACKUP_OFFSITE_ENCRYPTED=1
ATLAS_ARGUS_BASE_URL=https://replace-with-production-hostname
ATLAS_ARGUS_PRODUCTION_COMPOSE_FILE=docker-compose.production.example.yml
ATLAS_ARGUS_IMAGE_TAG=atlas-argus:production
ATLAS_ARGUS_SECURITY_REVIEW_SIGNOFF=replace-with-path-to-security-review-signoff
ATLAS_ARGUS_EVIDENCE_REVIEW_SIGNOFF=replace-with-path-to-evidence-review-signoff
ATLAS_ARGUS_RESTORE_DRILL_RECORD=replace-with-path-to-restore-drill-record
# Optional: comma-separated exact HTTPS origins only. Packaged same-origin production should leave this empty.
